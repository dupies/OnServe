{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@onserve/types": ["../../packages/types/src"],
      "@onserve/shared": ["../../packages/shared/src"],
      "@/*": ["./src/*"]
    },
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["nativewind/types", "react-native-css/types", "node"]
  },
  "include": ["src", "app", "app/**/*.tsx", "nativewind-env.d.ts", "types.d.ts"]
}
