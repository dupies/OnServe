{
  "name": "onserve",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "turbo": "latest",
    "typescript": "^5.4.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.2",
    "@rollup/rollup-linux-x64-musl": "4.60.2"
  },
  "overrides": {
    "ajv-keywords": {
      "ajv": "^8.0.0"
    }
  }
}
