{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@onserve/ui-tokens": ["./packages/ui-tokens/src"],
      "@onserve/ui-tokens/*": ["./packages/ui-tokens/src/*"],
      "@onserve/core": ["./packages/core/src"],
      "@onserve/core/*": ["./packages/core/src/*"],
      "@onserve/api": ["./packages/api/src"],
      "@onserve/api/*": ["./packages/api/src/*"],
      "@onserve/types": ["./packages/types/src"],
      "@onserve/types/*": ["./packages/types/src/*"],
      "@onserve/shared": ["./packages/shared/src"],
      "@onserve/shared/*": ["./packages/shared/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
